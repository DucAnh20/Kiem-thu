package com.example.utils;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class MathUtilsTest {

    @Test
    void testPerimeter() {
        assertEquals(14, MathUtils.perimeter(3,4));
        assertThrows(IllegalArgumentException.class, () -> MathUtils.perimeter(-1,2));
    }

    @Test
    void testArea() {
        assertEquals(12, MathUtils.area(3,4));
    }

    @Test
    void testQuadratic() {
        assertEquals("Not quadratic", MathUtils.quadratic(0,2,1));
        assertEquals("No solution", MathUtils.quadratic(1,0,1));
        assertTrue(MathUtils.quadratic(1,2,1).contains("One solution"));
        assertTrue(MathUtils.quadratic(1,-3,2).contains("Two solutions"));
    }

    @Test
    void testDaysInMonth() {
        assertEquals(31, MathUtils.daysInMonth(1,2024));
        assertEquals(29, MathUtils.daysInMonth(2,2024));
        assertEquals(28, MathUtils.daysInMonth(2,2023));
        assertThrows(IllegalArgumentException.class, () -> MathUtils.daysInMonth(13,2023));
    }

    @Test
    void testPrime() {
        assertTrue(MathUtils.isPrime(7));
        assertFalse(MathUtils.isPrime(1));
        assertFalse(MathUtils.isPrime(9));
    }

    @Test
    void testAlternatingSum() {
        assertEquals(3, MathUtils.alternatingSum(3));
        assertEquals(-2, MathUtils.alternatingSum(4));
    }

    @Test
    void testGCD() {
        assertEquals(6, MathUtils.gcd(12,18));
        assertEquals(5, MathUtils.gcd(0,5));
    }

    @Test
    void testFactorialSum() {
        assertEquals(9, MathUtils.factorialSum(3)); // 1!+2!+3!=9
        assertThrows(IllegalArgumentException.class, () -> MathUtils.factorialSum(-1));
    }
}
